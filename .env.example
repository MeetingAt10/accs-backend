NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173,http://portal.localhost:5173,http://forums.localhost:5173
# Registered users and password hashes. With AUTH_STORE_BUCKET set (Lambda), they live in one private S3 object.
# Otherwise a JSON file is used. No secrets belong here.
# AUTH_STORE_FILE=/tmp/accs-auth-store.json
# AUTH_STORE_BUCKET=
# AUTH_STORE_KEY=auth-store.json
