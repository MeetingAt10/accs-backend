NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173
# Registered users and password hashes. With AUTH_STORE_BUCKET set (Lambda), they live in one private S3 object.
# Otherwise a JSON file is used. No secrets belong here.
# AUTH_STORE_FILE=/tmp/accs-auth-store.json
# AUTH_STORE_BUCKET=
# AUTH_STORE_KEY=auth-store.json
# DynamoDB tables are <TABLE_PREFIX><DOC006 table>, e.g. accs-dev-ccs_identity (accs-architecture adr/0004).
# Holds server-side sessions, reset codes, and the domain state every instance shares (reports, consultations, slots,
# threads, notifications, audit); set on the Lambda.
# Unset locally: all of that is kept in memory and ends when the server restarts.
# TABLE_PREFIX=accs-dev-
# Sender of password reset and new-concern emails, a verified Amazon SES identity. Unset locally: both are logged.
# MAIL_FROM=
# Portal address for links in emails. Defaults to the first CORS_ORIGIN.
# APP_URL=http://localhost:5173
# Grafana Cloud OTLP (traces and logs). Unset sends nothing. Never commit the header value (Authorization=Basic <base64>).
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS=
# Critical concerns (harassment, threat, self-harm) start at the Guidance Office. On by default; set to false to turn off.
# ESCALATION_CRITICAL_TO_GUIDANCE=true
# A Program Chair conflict sends the concern to the Dean. Off by default until escalation authority is approved.
# ESCALATION_HIGHER_BYPASS=false
# Assistant model layer (src/assistant-ai.ts). Without a key the rule-based assistant answers alone. Secret: never commit it.
# Decision, identity and permission questions never reach the model. A student's draft is sent only from the drafting panel.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.4-mini
# OPENAI_TIMEOUT_MS=20000
