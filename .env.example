NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173
# Registered users and password hashes. With AUTH_STORE_BUCKET set (Lambda), they live in one private S3 object.
# Otherwise a JSON file is used. No secrets belong here.
# AUTH_STORE_FILE=/tmp/accs-auth-store.json
# AUTH_STORE_BUCKET=
# AUTH_STORE_KEY=auth-store.json
# DynamoDB tables are <TABLE_PREFIX><DOC006 table>, e.g. accs-dev-ccs_identity (accs-architecture adr/0004).
# Holds server-side sessions, reset codes, and the domain state every instance shares (reports, consultations, slots,
# threads, notifications, audit); set on the Lambda.
# Unset locally: all of that is kept in memory and ends when the server restarts.
# TABLE_PREFIX=accs-dev-
